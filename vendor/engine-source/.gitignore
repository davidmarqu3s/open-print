# Build artifacts (runtime, do not commit to repo)
/dist/
/node_modules/

# Cache / temp
/cache/
/tests/output/
/tests/temp/
/tests/*.log

# IDE / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Emscripten SDK (if installed locally)
/emsdk/

# Downloaded source (never commit upstream source)
/src/
/ghostscript-*/
/ghostpdl-*/
*.tar.gz
*.tar.xz
*.zip

# Test outputs
/tests/output/
/tests/temp/
/tests/*.log

# Node
/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
# ...but keep the package lockfile so CI installs are reproducible
!packages/**/package-lock.json

# Package build output (regenerated by `npm run build` in the package)
packages/*/dist/
packages/*/node_modules/

# IDE / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Docker
.dockerignore is tracked; these are not
.docker/

# Logs
*.log
npm-debug.log*
