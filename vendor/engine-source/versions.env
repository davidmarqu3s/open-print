# Pinned versions for reproducible Ghostscript WASM builds.
# Do not use floating tags in production builds.

# Ghostscript stable release
# Release: 10.07.1
# Release date: 2026-05-19
# Source: https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/tag/gs10071
GHOSTSCRIPT_VERSION=10.07.1
GHOSTSCRIPT_TAG=gs10071
GHOSTSCRIPT_SOURCE_TARBALL=https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/${GHOSTSCRIPT_TAG}/ghostscript-${GHOSTSCRIPT_VERSION}.tar.gz
GHOSTSCRIPT_SOURCE_TARBALL_SHA256=2fc74362f9be6fae1b0a65d38fdcfd4f0b518cc3b07c5581fb661eb4d2e15251

# Emscripten SDK release
# Using the latest stable Emscripten SDK that is validated for this build.
# Emscripten release: 6.0.7
# Release date: 2026-08-17
EMSCRIPTEN_VERSION=6.0.7

# Node.js version used for local testing (LTS)
NODE_VERSION=22.14.0
